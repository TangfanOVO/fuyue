# The reference server binds only to this computer by default.
FUYUE_RELAY_HOST=127.0.0.1
FUYUE_RELAY_PORT=8787
FUYUE_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Optional phone-friendly access code. The PWA exchanges it for an HttpOnly
# session cookie and never stores the code. Use a real auth service for multi-user hosting.
FUYUE_ACCESS_CODE=
# Cloud templates set this to 1 so a public relay cannot start without a code.
# FUYUE_REQUIRE_ACCESS_CODE=1

# DeepSeek: paste one API key and the relay is ready. The defaults follow the
# official OpenAI-compatible endpoint and current Flash model.
FUYUE_ACTIVE_PROVIDER=deepseek
FUYUE_DEEPSEEK_API_KEY=
FUYUE_DEEPSEEK_MODEL=deepseek-v4-flash
FUYUE_DEEPSEEK_BASE_URL=https://api.deepseek.com
FUYUE_DEEPSEEK_LABEL=DeepSeek V4 Flash

# Pick one configured provider. Several may be configured and shown in status.

# OpenAI Responses API. When this is the official OpenAI URL, the relay uses
# /v1/responses; a custom base URL falls back to OpenAI-compatible chat streams.
FUYUE_OPENAI_BASE_URL=https://api.openai.com/v1
FUYUE_OPENAI_API_KEY=
FUYUE_OPENAI_MODEL=
FUYUE_OPENAI_LABEL=OpenAI

# Gemini Interactions API.
FUYUE_GEMINI_API_KEY=
FUYUE_GEMINI_MODEL=
FUYUE_GEMINI_LABEL=Gemini

# Anthropic Messages API.
FUYUE_ANTHROPIC_API_KEY=
FUYUE_ANTHROPIC_MODEL=
FUYUE_ANTHROPIC_LABEL=Anthropic

# OpenAI-compatible presets. A key is enough to enable the documented default;
# set MODEL/BASE_URL to follow later provider changes without editing code.
FUYUE_GLM_API_KEY=
FUYUE_GLM_MODEL=
FUYUE_QWEN_API_KEY=
FUYUE_QWEN_MODEL=
FUYUE_KIMI_API_KEY=
FUYUE_KIMI_MODEL=
FUYUE_OPENROUTER_API_KEY=
FUYUE_OPENROUTER_MODEL=

# ChatGPT and Google AI subscriptions are not API keys. Do not paste browser
# cookies or account tokens here. A future local-client bridge must authenticate
# through the provider's official client and expose only the Fuyue relay contract.

# Optional read-only JSON files for the life and visible-mood endpoints.
FUYUE_LIFE_FILE=
FUYUE_MOOD_FILE=

# Engawa is installed by npm run setup into a loopback-only runtime.
FUYUE_ENGAWA_URL=http://127.0.0.1:8179

# Phone is a bundled feature. The chat provider above remains the brain; choose
# one voice provider for STT + TTS. These secrets stay in the relay process.
FUYUE_ACTIVE_VOICE_PROVIDER=elevenlabs

# ElevenLabs realtime Scribe + streaming TTS.
FUYUE_ELEVENLABS_API_KEY=
FUYUE_ELEVENLABS_VOICE_ID=
FUYUE_ELEVENLABS_MODEL=eleven_flash_v2_5

# Doubao realtime duplex speech. Voice names come from the user's Doubao account.
FUYUE_DOUBAO_DUPLEX_API_KEY=
FUYUE_DOUBAO_DUPLEX_VOICE=
FUYUE_DOUBAO_DUPLEX_MODEL=1.2.6.1
FUYUE_DOUBAO_DUPLEX_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue

# Optional provider-neutral JSON adapter. Both endpoints must use HTTPS unless
# they are localhost. See docs/RELAY_API_CONTRACT.md for request/response bodies.
FUYUE_CUSTOM_VOICE_API_KEY=
FUYUE_CUSTOM_VOICE_STT_URL=
FUYUE_CUSTOM_VOICE_TTS_URL=
FUYUE_CUSTOM_VOICE_ID=default
FUYUE_CUSTOM_VOICE_MODEL=default

# To bind a public interface, put the relay behind an authenticated HTTPS reverse
# proxy, set a strict origin allowlist, then explicitly acknowledge the boundary.
# FUYUE_TRUSTED_PROXY=1
